---
import QuoteCalculator from './QuoteCalculator';
---

<section id="cotizar" aria-labelledby="cotizar-title" class="bg-glow py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-2xl">
      <h2 id="cotizar-title" class="text-3xl font-bold tracking-[-0.035em] text-slate-900 sm:text-[2.75rem] sm:leading-[1.08]">
        Calculá cuánto sale tu envío
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-500">
        Pagás por distancia y tamaño, nada más. Mové la distancia y mirá el precio antes de sumarte.
      </p>
    </div>
    <div class="reveal mt-10">
      <QuoteCalculator client:visible />
    </div>
  </div>
</section>
