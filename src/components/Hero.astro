---
import { MapPin } from 'lucide-react';
import HeroIllustration from './HeroIllustration.astro';
import Marquee from './Marquee.astro';
import { site } from '../data/site';
---

<section aria-labelledby="hero-title" class="hero-bg relative isolate overflow-hidden">
  <!-- Fondo: auroras de color que se desplazan lento -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="aurora aurora-a"></div>
    <div class="aurora aurora-b"></div>
    <div class="aurora aurora-c"></div>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pt-14 pb-14 sm:px-8 lg:grid-cols-[0.95fr_1.1fr] lg:gap-4 lg:pt-20 lg:pb-20">
    <div class="max-w-xl">
      <h1
        id="hero-title"
        class="rise text-[2.625rem] leading-[1.04] font-bold tracking-[-0.04em] text-slate-900 sm:text-6xl lg:text-[4.25rem]"
      >
        La plataforma de envíos <span class="text-brand-600">rápidos</span> para tu comercio
      </h1>
      <p class="rise rise-2 mt-6 max-w-[34rem] text-lg leading-relaxed text-slate-600 sm:text-xl sm:leading-relaxed">
        Despachá los pedidos de tu restaurante, kiosco, farmacia o distribuidora con repartidores profesionales. Sin
        comisiones abusivas, con costos claros por kilómetro y seguimiento en tiempo real.
      </p>

      <div class="rise rise-3 mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={site.links.merchantSignup}
          aria-label="Sumar mi comercio a repa"
          class="btn-shine group relative inline-flex h-13 items-center justify-center gap-2 overflow-hidden rounded-full bg-brand-600 px-7 text-base font-semibold text-white shadow-[0_10px_30px_-10px_rgb(0_85_255/0.7)] transition-[background-color,transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-[0_16px_36px_-12px_rgb(0_85_255/0.8)] active:translate-y-0 active:scale-[0.98]"
        >
          Sumar mi comercio
          <svg viewBox="0 0 20 20" class="size-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 10h12M11 5l5 5-5 5"></path>
          </svg>
        </a>
        <a
          href={site.links.driverSignup}
          aria-label="Quiero ser repartidor de repa"
          class="inline-flex h-13 items-center justify-center rounded-full border border-slate-300/80 bg-white/70 px-7 text-base font-semibold text-slate-900 backdrop-blur transition-[background-color,border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-slate-400 hover:bg-white active:translate-y-0 active:scale-[0.98]"
        >
          Quiero ser repartidor
        </a>
      </div>

      <p class="rise rise-4 mt-6 inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-white/60 py-1.5 pr-3.5 pl-2 text-sm font-medium text-slate-700 backdrop-blur">
        <span class="relative flex size-6 items-center justify-center rounded-full bg-brand-50 text-brand-600">
          <span class="ping absolute inset-0 rounded-full bg-brand-600/20"></span>
          <MapPin className="relative size-3.5" aria-hidden="true" strokeWidth={2.5} />
        </span>
        Repartimos en {site.area.label}
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-[40rem] lg:-mr-6">
      <HeroIllustration />
    </div>
  </div>

  <Marquee />
</section>
