---
import Logo from './Logo.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Producto',
    links: [
      { label: 'Soluciones', href: '/#soluciones' },
      { label: 'Beneficios', href: '/#beneficios' },
      { label: 'Cómo funciona', href: '/#como-funciona' },
      { label: 'Preguntas frecuentes', href: '/#faq' },
    ],
  },
  {
    title: 'Comercios',
    links: [
      { label: 'Sumar mi comercio', href: site.links.merchantSignup },
      { label: 'Calcular un envío', href: '/#cotizar' },
      { label: 'Iniciar sesión', href: site.links.login },
    ],
  },
  {
    title: 'Repartidores',
    links: [
      { label: 'Quiero ser repartidor', href: site.links.driverSignup },
      { label: 'App repa PRO', href: site.links.driverApp },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Términos y condiciones', href: '/terminos' },
      { label: 'Política de privacidad', href: '/privacidad' },
    ],
  },
];
---

<footer class="bg-white">
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-10 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">
      <div>
        <a href="/" class="inline-block rounded-full" aria-label="repa PRO, ir al inicio"><Logo /></a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-500">
          Envíos de última milla para comercios de {site.area.label}.
        </p>
        <address class="mt-5 space-y-1 text-sm text-slate-600 not-italic">
          <span class="block">{site.contact.email}</span>
          <span class="block">WhatsApp {site.contact.whatsapp}</span>
        </address>
      </div>

      <nav aria-label="Enlaces del sitio" class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {
          columns.map((col) => (
            <div>
              <h2 class="text-sm font-semibold text-slate-900">{col.title}</h2>
              <ul class="mt-4 space-y-3">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="text-sm text-slate-500 transition-colors hover:text-slate-900 hover:underline">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-slate-200 pt-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} repa. Todos los derechos reservados.</p>
      <ul class="flex gap-5" aria-label="Redes sociales">
        {
          site.social.map((s) => (
            <li>
              <a href={s.href} class="hover:text-slate-900 hover:underline" aria-label={`repa en ${s.label}`} rel="noopener">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
