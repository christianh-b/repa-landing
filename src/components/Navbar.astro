---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
---

<header class="nav-scroll sticky top-0 z-50 border-b border-transparent bg-white/70 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <a href="/" class="rounded-full" aria-label="repa PRO, ir al inicio">
      <Logo />
    </a>

    <nav aria-label="Secciones" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <a
        href={site.links.login}
        aria-label="Iniciar sesión en repa"
        class="rounded-full px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-900"
      >
        Iniciar sesión
      </a>
      <a
        href={site.links.merchantSignup}
        aria-label="Sumar mi comercio a repa"
        class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-card transition-colors hover:bg-brand-700"
      >
        Sumar mi comercio
      </a>
    </div>

    <!-- Menú mobile sin JavaScript: <details> nativo. -->
    <details class="group relative md:hidden">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full text-slate-800 hover:bg-slate-100"
        aria-label="Abrir menú"
      >
        <svg viewBox="0 0 24 24" class="size-6 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg viewBox="0 0 24 24" class="hidden size-6 group-open:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <nav
        aria-label="Secciones (mobile)"
        class="absolute top-[calc(100%+0.75rem)] right-0 w-[min(20rem,calc(100vw-2.5rem))] rounded-2xl border border-slate-200/80 bg-white p-2 shadow-float"
      >
        <ul class="flex flex-col">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="block rounded-xl px-4 py-3 text-[0.9375rem] font-medium text-slate-800 hover:bg-slate-50">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-2 grid gap-2 border-t border-slate-100 p-2 pt-3">
          <a
            href={site.links.merchantSignup}
            aria-label="Sumar mi comercio a repa"
            class="rounded-full bg-brand-600 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-brand-700"
          >
            Sumar mi comercio
          </a>
          <a
            href={site.links.login}
            aria-label="Iniciar sesión en repa"
            class="rounded-full border border-slate-200 px-4 py-3 text-center text-sm font-medium text-slate-800 hover:bg-slate-50"
          >
            Iniciar sesión
          </a>
        </div>
      </nav>
    </details>
  </div>
</header>
