---
const items = [
  'Restaurantes',
  'Kioscos',
  'Almacenes',
  'Farmacias',
  'Perfumerías',
  'Tiendas',
  'Distribuidoras',
  'Seguimiento en vivo',
  'Prueba de entrega con foto',
  'Costos por kilómetro',
];
---

<div class="marquee relative border-y border-slate-200/70 bg-white/50 py-4 backdrop-blur-sm">
  <p class="sr-only">Para restaurantes, kioscos, almacenes, farmacias, perfumerías, tiendas y distribuidoras.</p>
  <div class="marquee-track flex w-max" aria-hidden="true">
    {
      [0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {items.map((item) => (
            <li class="flex items-center gap-3 px-5 text-sm font-semibold whitespace-nowrap text-slate-600">
              <span class="size-1.5 rounded-full bg-brand-600" />
              {item}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
