---
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class="inline-flex items-center gap-1.5">
  <span class:list={['text-[1.375rem] leading-none font-bold tracking-[-0.04em]', tone === 'dark' ? 'text-slate-900' : 'text-white']}>
    repa
  </span>
  <span
    class:list={[
      'inline-flex items-center gap-1 rounded-full py-0.5 pr-1 pl-2 text-[0.6875rem] leading-4 font-semibold tracking-wide',
      tone === 'dark' ? 'bg-brand-600 text-white' : 'bg-white text-brand-700',
    ]}
  >
    PRO
    <svg viewBox="0 0 16 16" class="size-3.5" aria-hidden="true">
      <circle cx="8" cy="8" r="7" class:list={[tone === 'dark' ? 'fill-white' : 'fill-brand-600']}></circle>
      <path
        d="M5 8.3l2 2 4-4.3"
        fill="none"
        class:list={[tone === 'dark' ? 'stroke-brand-600' : 'stroke-white']}
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</span>
