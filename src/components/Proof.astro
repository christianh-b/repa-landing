---
// Espacio reservado para prueba social real. Solo se muestra en desarrollo (npm run dev)
// hasta que cargues testimonios reales y pongas `ready = true`.
const ready = false;
const show = ready || import.meta.env.DEV;

const testimonials = [
  { quote: '[TESTIMONIO DE UN COMERCIO]', name: '[NOMBRE]', business: '[COMERCIO · RUBRO]' },
  { quote: '[TESTIMONIO DE UN COMERCIO]', name: '[NOMBRE]', business: '[COMERCIO · RUBRO]' },
  { quote: '[TESTIMONIO DE UN REPARTIDOR]', name: '[NOMBRE]', business: 'Repartidor repa PRO' },
];
---

{
  show && (
    <section aria-labelledby="prueba-title" class="pb-20 sm:pb-28">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        {!ready && (
          <p class="mb-4 rounded-xl border border-dashed border-amber-400 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Sección reservada: solo visible en desarrollo. Completá los testimonios en
            <code class="font-semibold">src/components/Proof.astro</code> y poné <code class="font-semibold">ready = true</code>.
          </p>
        )}
        <h2 id="prueba-title" class="text-3xl font-bold tracking-[-0.035em] text-slate-900 sm:text-[2.75rem] sm:leading-[1.08]">
          Comercios que ya despachan con repa
        </h2>
        <ul class="mt-10 grid gap-4 md:grid-cols-3">
          {testimonials.map((t) => (
            <li>
              <figure class="h-full rounded-2xl border border-slate-200/80 bg-white p-6 shadow-card">
                <blockquote class="text-lg leading-relaxed text-slate-800">“{t.quote}”</blockquote>
                <figcaption class="mt-5 text-sm">
                  <span class="block font-semibold text-slate-900">{t.name}</span>
                  <span class="text-slate-500">{t.business}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
