---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Verticals from '../components/Verticals.astro';
import Benefits from '../components/Benefits.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Quote from '../components/Quote.astro';
import Proof from '../components/Proof.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { homeSchema } from '../lib/schema';

const title = 'repa | Envíos rápidos para tu comercio en Cañuelas';
---

<Layout
  title={title}
  description={site.description}
  canonicalURL={new URL('/', Astro.site)}
  ogImage="/og.png"
  jsonLd={homeSchema(Astro.site!.href)}
>
  <Navbar />
  <main id="contenido">
    <Hero />
    <Verticals />
    <Benefits />
    <HowItWorks />
    <Quote />
    <Proof />
    <FAQ />
    <CtaBand />
  </main>
  <Footer />
</Layout>
