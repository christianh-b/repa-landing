---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Términos y condiciones | repa" description="Términos y condiciones de uso de repa." noindex>
  <Navbar />
  <main id="contenido" class="mx-auto max-w-3xl px-5 py-20 sm:px-8">
    <h1 class="text-4xl font-bold tracking-[-0.035em] text-slate-900">Términos y condiciones</h1>
    <p class="mt-6 text-lg leading-relaxed text-slate-500">[TEXTO LEGAL DE TÉRMINOS Y CONDICIONES]</p>
  </main>
  <Footer />
</Layout>
